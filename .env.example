# Pengaturan Database
# Gunakan "sqlite:///./sfi_database.db" untuk development lokal
# Gunakan "postgresql://user:password@localhost:5432/sfi_db" untuk production
DATABASE_URL="sqlite:///./sfi_database.db"

# Pengaturan Telegram Bot
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="isi_dengan_token_bot_telegram_anda"

# Pengaturan LLM Groq (Untuk fitur AI Scanner)
GROQ_API_KEY="isi_dengan_api_key_groq"

# Kunci Enkripsi (SKPL-NF04 — Keamanan Data Pengguna)
# Generate dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="isi_dengan_fernet_key"
